{%- set t = i18n[lang] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.author }}{% else %}{{ t.homeTitle }}{% endif %}</title>
  <meta name="description" content="{{ description or 'SUNDROP website.' }}">
  {%- if altUrl %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ t.switchLang }}" href="{{ site.url }}{{ altUrl }}">
  {%- endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#17112e">
  <link rel="stylesheet" href="/css/style.css">
  {%- if page.url == t.home %}
  <link rel="preload" as="image" href="/img/hero-900.webp" type="image/webp" media="(max-width: 40rem)" fetchpriority="high">
  <link rel="preload" as="image" href="/img/hero-1600.webp" type="image/webp" media="(min-width: 40.01rem)" fetchpriority="high">
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip }}</a>
  <header class="site-header">
    <a class="wordmark" href="{{ t.home }}" aria-label="{{ t.homeLabel }}">{{ site.title }}</a>
    <nav class="site-nav" aria-label="{{ t.navLabel }}">
      <ul>
        {% for item in t.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <a class="button header-tickets" href="{{ events.tickets }}" rel="noopener">{{ t.tickets }}</a>
    {%- if altUrl %}
    <a class="lang-switch" href="{{ altUrl }}" hreflang="{{ t.switchLang }}" lang="{{ t.switchLang }}" aria-label="{{ t.switchLabel }}, {{ t.switchName }}">{{ t.switchLabel }}</a>
    {%- endif %}
  </header>

  <main id="main" class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ site.copyrightYears }} {{ site.author }}, {{ t.footer }}</p>
    <ul>
      <li><a href="{{ site.instagram }}" rel="noopener">Instagram</a></li>
      <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
    </ul>
    <p class="footer-mark" aria-hidden="true">{{ site.title }}</p>
  </footer>
</body>
</html>
